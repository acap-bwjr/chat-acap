# --- Servidor ---
PORT=4000
JWT_SECRET=troque-por-um-segredo-forte
FRONTEND_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:4000

# --- Banco (Postgres via Supabase) ---
# Settings -> Database -> Connection string -> URI (Session pooler, porta 5432)
DATABASE_URL=postgresql://postgres.xxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# --- Supabase Storage (mídia) ---
# Settings -> API: Project URL e service_role key
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=chat-midia

# Modo sandbox: não chama o WhatsApp de verdade (para testar local)
WA_SANDBOX=true

# --- WhatsApp Cloud API (preencher no cutover) ---
WA_PHONE_NUMBER_ID=
WA_WABA_ID=
WA_ACCESS_TOKEN=
WA_VERIFY_TOKEN=provai-chat-verify
